// ── GRÁFICAS ─────────────────────────────────────────────────
const GDESCS={"Barras":"Compara cantidades entre categorías.","Líneas":"Muestra tendencias en el tiempo.","Pastel":"Proporciones de un todo.","Dispersión":"Relación entre dos variables.","Histograma":"Distribución de frecuencias.","Tabla":"Organiza datos en filas/columnas."};
let grafTipo="Barras";
function grafHTML(){
  const opts=Object.keys(GDESCS).map(t=>`<button class="sub-btn${t==="Barras"?" active":""}" onclick="setGraf('${t}',this)">${t}</button>`).join("");
  return`<div class="sub-nav">${opts}</div><div id="gdesc" style="font-size:12px;color:var(--gr);margin-bottom:10px">${GDESCS["Barras"]}</div>
    <div class="panel"><div class="field"><label>Datos numéricos (coma)</label><input type="text" id="gd" placeholder="ej: 10, 25, 15, 30"></div>
    <div class="field"><label>Etiquetas (opcional)</label><input type="text" id="gl" placeholder="ej: Ene, Feb, Mar"></div>
    <div class="chart-area" id="gchart" style="display:flex;align-items:center;justify-content:center;color:var(--gr);font-size:12px">Ingresa datos para ver la gráfica</div>
    <button class="calc-btn" onclick="renderGraf()">Generar gráfica ▶</button></div>`;
}
function setGraf(t,btn){grafTipo=t;document.querySelectorAll("#modal .sub-nav .sub-btn").forEach(b=>b.className="sub-btn");btn.className="sub-btn active";const d=document.getElementById("gdesc");if(d)d.textContent=GDESCS[t]||"";}
const GCLS=["#a78bfa","#5dcaa5","#f97316","#60a5fa","#f472b6","#34d399"];
function renderGraf(){
  const nums=(gvs("gd")).split(",").map(s=>parseFloat(s.trim())).filter(n=>!isNaN(n));
  const labs=(gvs("gl")).split(",").map(s=>s.trim());
  const c=document.getElementById("gchart");if(!nums.length){c.innerHTML='Ingresa datos';return;}
  const mx=Math.max(...nums)||1;
  if(grafTipo==="Barras"||grafTipo==="Histograma"){
    c.innerHTML=`<div class="chart-bars">${nums.map((v,i)=>`<div class="bar-wrap"><div class="bar-val">${v}</div><div class="bar" style="height:${(v/mx)*90}px;background:${GCLS[i%GCLS.length]}88;border:1px solid ${GCLS[i%GCLS.length]}"></div><div class="bar-lbl">${labs[i]||i+1}</div></div>`).join("")}</div>`;
  }else if(grafTipo==="Líneas"){
    const w=220,h=90,pts=nums.map((v,i)=>[(i/(nums.length-1||1))*w,(1-v/mx)*h]);
    c.innerHTML=`<svg width="100%" viewBox="0 0 ${w} ${h+16}"><polyline points="${pts.map(p=>p.join(",")).join(" ")}" fill="none" stroke="#5dcaa5" stroke-width="2"/>${pts.map(([x,y],i)=>`<circle cx="${x}" cy="${y}" r="3.5" fill="#5dcaa5"/><text x="${x}" y="${y-7}" text-anchor="middle" font-size="8" fill="#a78bfa">${nums[i]}</text>`).join("")}</svg>`;
  }else if(grafTipo==="Pastel"){
    let ang=0;const tot=nums.reduce((a,b)=>a+b,0);
    c.innerHTML=`<svg width="110" height="110" viewBox="0 0 110 110" style="display:block;margin:0 auto">${nums.map((v,i)=>{const sw=(v/tot)*360,sa=ang,ea=ang+sw;ang+=sw;const r=48,cx=55,cy=55,s2=sa*PI/180,e2=ea*PI/180,x1=cx+r*Math.cos(s2),y1=cy+r*Math.sin(s2),x2=cx+r*Math.cos(e2),y2=cy+r*Math.sin(e2),lg=sw>180?1:0;return`<path d="M${cx},${cy} L${x1},${y1} A${r},${r} 0 ${lg},1 ${x2},${y2} Z" fill="${GCLS[i%GCLS.length]}aa" stroke="${GCLS[i%GCLS.length]}" stroke-width="1"/>`;}).join("")}</svg>`;
  }else if(grafTipo==="Dispersión"){
    const pts=nums.map((v,i)=>[(i/(nums.length-1||1))*180+10,110-(v/mx)*100]);
    c.innerHTML=`<svg width="100%" viewBox="0 0 200 120">${pts.map(([x,y])=>`<circle cx="${x}" cy="${y}" r="5" fill="#a78bfa" opacity="0.8"/>`).join("")}<line x1="10" y1="110" x2="190" y2="110" stroke="#9ca3af" stroke-width="1"/><line x1="10" y1="10" x2="10" y2="110" stroke="#9ca3af" stroke-width="1"/></svg>`;
  }else{
    c.innerHTML=`<table style="width:100%;border-collapse:collapse"><tr><th style="padding:4px 8px;color:var(--g);font-size:11px;text-align:left">Etiqueta</th><th style="padding:4px 8px;color:var(--g);font-size:11px;text-align:left">Valor</th></tr>${nums.map((v,i)=>`<tr><td style="padding:4px 8px;color:var(--gr);font-size:11px">${labs[i]||"Dato "+(i+1)}</td><td style="padding:4px 8px;color:#e8eaf0;font-size:11px">${v}</td></tr>`).join("")}</table>`;
  }
  addLine(`Gráfica ${grafTipo}: [${nums.join(",")}]`);
}

