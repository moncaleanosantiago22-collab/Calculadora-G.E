  <text x="140" y="311" text-anchor="middle" font-size="13" fill="<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculadora G.E</title>
<style>
:root{--p:#a78bfa;--g:#5dcaa5;--dk:#0f1117;--cd:#161b27;--c2:#1e1530;--gr:#9ca3af;--or:#f97316;--rd:#e74c3c}
*{box-sizing:border-box;margin:0;padding:0}
body{background:#070a10;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px;font-family:monospace}
.phone{width:360px;background:var(--dk);border-radius:40px;border:2.5px solid var(--p);padding:20px 16px 28px;box-shadow:0 0 60px rgba(167,139,250,0.15)}
.display{background:var(--dk);border:2px solid var(--g);border-radius:14px;padding:10px 14px;margin-bottom:12px;min-height:110px;position:relative}
.display-label{font-size:9px;color:var(--g);letter-spacing:1px;margin-bottom:6px}
.display-lines{max-height:150px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--p) var(--dk)}
.line-expr{font-size:13px;color:var(--gr);padding:2px 0}
.line-result-wrap{display:flex;align-items:center;gap:8px;padding:4px 0 2px}
.line-result-eq{font-size:11px;color:var(--g)}
.line-result-val{font-size:20px;font-weight:700;color:var(--p)}
.line-term{font-size:13px;color:#e8eaf0;padding:2px 0;border-bottom:1px solid #1a2030}
.proc-box{background:var(--c2);border-radius:8px;padding:8px 10px;margin:4px 0 6px}
.proc-title{font-size:10px;color:var(--p);font-weight:700;margin-bottom:6px;border-left:2px solid var(--p);padding-left:6px}
.proc-step{display:flex;gap:6px;margin-bottom:5px;align-items:flex-start}
.step-num{min-width:16px;height:16px;border-radius:50%;background:var(--dk);border:1px solid var(--p);display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--p);font-weight:700;flex-shrink:0;margin-top:1px}
.step-label{font-size:10px;color:var(--gr)}
.step-val{font-size:11px;color:#e8eaf0;background:var(--cd);border-radius:4px;padding:3px 6px;margin-top:2px;border-left:2px solid var(--p)}
.input-bar{border-top:1px solid #2a2f3e;padding-top:6px;margin-top:4px;display:none}
.input-label{font-size:9px;color:var(--gr);margin-bottom:2px}
.input-expr{font-size:16px;color:#e8eaf0}
.cursor{display:inline-block;width:2px;height:16px;background:var(--p);margin-left:2px;animation:blink 1s infinite;vertical-align:middle}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
.limpiar{position:absolute;top:8px;right:10px;background:none;border:none;color:#2a3550;cursor:pointer;font-size:10px}
.tabs{display:flex;gap:5px;margin-bottom:14px}
.tab{flex:1;padding:7px 3px;border-radius:8px;font-size:8px;font-weight:700;cursor:pointer;border:1.8px solid;text-align:center}
.scroll-area{max-height:400px;overflow-y:auto;padding-right:2px;scrollbar-width:thin;scrollbar-color:var(--p) var(--dk)}
.btn-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.cbtn{aspect-ratio:1;border-radius:50%;border:2px solid;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-direction:column;transition:transform 0.1s,filter 0.1s;user-select:none;background:var(--c2)}
.cbtn:active{transform:scale(0.87);filter:brightness(1.7)}
.cbtn.gbg{background:var(--cd)}
.cbtn.rdbg{background:#1a0808}
.scroll-hint{text-align:center;margin-top:10px;color:var(--gr);font-size:9px;opacity:0.4}
.overlay{display:none;position:fixed;inset:0;background:rgba(7,10,16,0.88);z-index:200;align-items:flex-end;justify-content:center;backdrop-filter:blur(4px)}
.overlay.show{display:flex}
.modal{background:var(--cd);border:1.5px solid var(--p);border-radius:22px 22px 0 0;padding:20px 18px 28px;width:100%;max-width:360px;max-height:82vh;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--p) var(--dk);animation:slideUp 0.22s ease}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.modal-title{font-size:13px;color:var(--p);font-weight:700}
.modal-close{background:var(--c2);border:1px solid #2a2f3e;color:var(--gr);border-radius:6px;padding:3px 10px;cursor:pointer;font-size:12px}
.info-box{border-radius:10px;padding:12px;margin-bottom:10px;border:1px solid}
.info-title{font-size:11px;font-weight:700;margin-bottom:6px;letter-spacing:1px}
.info-text{font-size:12px;color:var(--gr);line-height:1.6}
.sub-nav{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.sub-btn{background:transparent;border:1px solid #2a2f3e;color:var(--gr);padding:5px 10px;border-radius:6px;cursor:pointer;font-size:11px}
.sub-btn.active{border-color:var(--g);color:var(--g);background:#0b1f18}
.field{margin-bottom:10px}
.field label{display:block;font-size:11px;color:var(--gr);margin-bottom:3px}
.field input,.field select,.field textarea{width:100%;background:var(--dk);border:1px solid #2a2f3e;border-radius:8px;padding:7px 10px;color:#e8eaf0;font-size:13px;font-family:monospace;outline:none}
.field textarea{resize:vertical;min-height:56px}
.calc-btn{width:100%;background:var(--p);border:none;border-radius:8px;padding:10px;color:var(--c2);font-size:13px;font-weight:700;cursor:pointer;margin-top:6px}
.panel{background:var(--cd);border:1px solid #2a2f3e;border-radius:12px;padding:16px;margin-bottom:10px}
.rgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px}
.rcard{background:var(--dk);border-radius:8px;padding:10px;border:1px solid #2a2f3e}
.rcard-label{font-size:10px;color:var(--gr)}
.rcard-val{font-size:14px;font-weight:700;color:var(--p);margin-top:2px;word-break:break-all}
.result-box{margin-top:12px;background:var(--dk);border:1px solid var(--g);border-radius:10px;padding:14px}
.op-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.op-card{background:var(--c2);border:2px solid;border-radius:14px;padding:20px 10px;cursor:pointer;text-align:center;transition:all 0.15s}
.op-card:hover{box-shadow:0 0 16px rgba(167,139,250,0.3)}
.op-sym{font-size:36px;font-weight:700;margin-bottom:8px}
.op-name{font-size:13px;font-weight:700;margin-bottom:4px}
.op-desc{font-size:11px;color:var(--gr);line-height:1.5}
.op-ex{font-size:11px;color:var(--gr);margin-top:6px}
.fig-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:10px}
.fig-card{background:var(--cd);border:1.5px solid #2a2f3e;border-radius:8px;padding:8px 4px;cursor:pointer;text-align:center;transition:all 0.15s}
.fig-card:hover,.fig-card.sel{border-color:var(--p)}
.fig-ico{font-size:18px;margin-bottom:2px}
.fig-name{font-size:9px;color:var(--gr)}
.obj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.obj-card{background:var(--cd);border:1.5px solid #2a2f3e;border-radius:10px;padding:10px 6px;cursor:pointer;text-align:center;transition:border-color 0.15s}
.obj-card:hover{border-color:var(--or)}
.obj-ico{font-size:26px;margin-bottom:4px}
.obj-name{font-size:10px;color:var(--gr)}
.letra-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}
.letra-btn{background:var(--c2);border:1.5px solid #2a2f3e;border-radius:8px;padding:8px 4px;cursor:pointer;text-align:center;color:var(--gr);font-size:15px;font-family:Georgia,serif;font-weight:700;transition:all 0.15s}
.letra-btn:hover{border-color:var(--p);color:var(--p)}
.num-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.num-btn{background:var(--c2);border:2px solid var(--p);border-radius:10px;padding:14px 8px;cursor:pointer;text-align:center;color:var(--p);font-size:22px;font-weight:700}
.chart-area{background:var(--dk);border:1px solid #2a2f3e;border-radius:10px;padding:12px;margin-top:6px;min-height:60px}
.chart-bars{display:flex;align-items:flex-end;gap:4px;height:100px;padding:0 4px}
.bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px}
.bar-val{font-size:8px;color:var(--p)}
.bar{width:100%;border-radius:3px 3px 0 0}
.bar-lbl{font-size:8px;color:var(--gr);overflow:hidden;max-width:28px;text-align:center}
.prob-header{display:flex;align-items:center;gap:10px;background:var(--c2);border:1px solid var(--or);border-radius:10px;padding:10px 14px;margin-bottom:14px}
.prob-enunciado{background:#0b1f18;border:1px solid var(--g);border-radius:10px;padding:12px;margin-bottom:10px;font-size:12px;color:#e8eaf0;line-height:1.7;display:none}
.solve-btn{width:100%;border:none;border-radius:8px;padding:10px;font-size:13px;font-weight:700;cursor:pointer;margin-bottom:4px}
.insert-btn{width:100%;background:var(--c2);border:1px solid var(--g);border-radius:8px;padding:8px;color:var(--g);font-size:12px;font-weight:700;cursor:pointer;margin-top:6px}
.modo-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px}
.modo-card{border:2px solid #2a2f3e;border-radius:10px;padding:12px 8px;cursor:pointer;text-align:center;background:var(--cd)}
.modo-card.ap{border-color:var(--p);background:var(--c2)}
.modo-card.ag{border-color:var(--g);background:#0b1f18}
</style>
</head>
<body>
<div class="phone">
  <!-- DISPLAY -->
  <div class="display">
    <button class="limpiar" onclick="limpiarTodo()">limpiar</button>
    <div class="display-label">PANTALLA PRINCIPAL</div>
    <div class="display-lines" id="dl">
      <div style="font-size:12px;color:#2a3550">Toca un botón para insertar...</div>
    </div>
    <div class="input-bar" id="ib">
      <div class="input-label">expresión actual:</div>
      <div class="input-expr" id="ie">0<span class="cursor"></span></div>
    </div>
  </div>

  <!-- TABS -->
  <div class="tabs">
    <div class="tab" style="border-color:var(--p);color:var(--p);background:var(--c2)" onclick="openModal('trig')">cos sen tan</div>
    <div class="tab" style="border-color:var(--g);color:var(--g);background:#0b1f18" onclick="openModal('pob')">POB</div>
    <div class="tab" style="border-color:var(--g);color:var(--g);background:#0b1f18" onclick="openModal('muestra')">Muestra</div>
    <div class="tab" style="border-color:var(--g);color:var(--g);background:#0b1f18" onclick="openModal('desv')">D.E</div>
  </div>

  <!-- BOTONES -->
  <div class="scroll-area">
    <div class="btn-grid">
      <div class="cbtn" style="border-color:var(--p)" onclick="openModal('figuras')"><svg width="34" height="34" viewBox="0 0 44 44"><polygon points="10,34 22,10 34,34" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linejoin="round"/><circle cx="22" cy="34" r="7" fill="none" stroke="#5dcaa5" stroke-width="1.8"/><polyline points="10,28 15,28 15,34" fill="none" stroke="#a78bfa" stroke-width="1.4"/></svg></div>
      <div class="cbtn" style="border-color:var(--p)" onclick="openModal('area')"><span style="font-size:26px;font-weight:700;color:var(--p);font-family:Georgia,serif">A</span></div>
      <div class="cbtn gbg" style="border-color:var(--g)" onclick="openModal('perim')"><span style="font-size:24px;font-weight:700;color:var(--g);font-family:Georgia,serif">P</span></div>
      <div class="cbtn gbg" style="border-color:var(--g)" onclick="openModal('letras')"><div style="text-align:center;line-height:1.2"><span style="font-size:12px;color:var(--g);font-weight:700;display:block">A</span><span style="font-size:11px;color:var(--gr);display:block">BC</span></div></div>
      <div class="cbtn" style="border-color:var(--p)" onclick="presionarIgual()"><span style="font-size:24px;color:var(--p)">＝</span></div>
      <div class="cbtn gbg" style="border-color:var(--g)" onclick="openModal('graficas')"><svg width="34" height="34" viewBox="0 0 40 40"><rect x="6" y="24" width="8" height="10" rx="2" fill="#5dcaa5" opacity="0.5"/><rect x="16" y="16" width="8" height="18" rx="2" fill="#5dcaa5" opacity="0.8"/><rect x="26" y="8" width="8" height="26" rx="2" fill="#5dcaa5"/></svg></div>
      <div class="cbtn" style="border-color:var(--p)" onclick="openModal('porcentaje')"><span style="font-size:21px;font-weight:700;color:var(--p)">%</span></div>
      <div class="cbtn gbg" style="border-color:var(--g)" onclick="openModal('raiz')"><span style="font-size:25px;color:var(--g);font-family:Georgia,serif">√</span></div>
      <div class="cbtn" style="border-color:var(--p)" onclick="openModal('sigma')"><span style="font-size:25px;color:var(--p);font-family:Georgia,serif">Σ</span></div>
      <div class="cbtn" style="border-color:var(--p)" onclick="openModal('numeros')"><div style="text-align:center;line-height:1.4"><span style="font-size:10px;color:var(--p);display:block">1  2</span><span style="font-size:10px;color:var(--gr);display:block">3  4</span></div></div>
      <div class="cbtn gbg" style="border-color:var(--g)" onclick="openModal('trig')"><svg width="34" height="34" viewBox="0 0 44 44"><polygon points="8,36 8,10 36,36" fill="none" stroke="#5dcaa5" stroke-width="2.2" stroke-linejoin="round"/><polyline points="8,26 14,26 14,36" fill="none" stroke="#a78bfa" stroke-width="1.8"/></svg></div>
      <div class="cbtn gbg" style="border-color:var(--g)" onclick="openModal('mmm')"><div style="text-align:center;line-height:1.3"><span style="font-size:13px;color:var(--g);font-weight:700;display:block;font-family:Georgia,serif">M</span><span style="font-size:11px;color:var(--gr);display:block">M M</span></div></div>
      <div class="cbtn" style="border-color:var(--p)" onclick="openModal('sumaresta')"><svg width="34" height="34" viewBox="0 0 44 44"><line x1="10" y1="18" x2="22" y2="18" stroke="#a78bfa" stroke-width="2.8"/><line x1="16" y1="12" x2="16" y2="24" stroke="#a78bfa" stroke-width="2.8"/><line x1="22" y1="31" x2="34" y2="31" stroke="#5dcaa5" stroke-width="2.8"/><line x1="21" y1="34" x2="23" y2="10" stroke="#9ca3af" stroke-width="1.2"/></svg></div>
      <div class="cbtn gbg" style="border-color:var(--g)" onclick="openModal('multdiv')"><svg width="34" height="34" viewBox="0 0 44 44"><line x1="10" y1="14" x2="20" y2="24" stroke="#5dcaa5" stroke-width="2.8"/><line x1="20" y1="14" x2="10" y2="24" stroke="#5dcaa5" stroke-width="2.8"/><line x1="24" y1="28" x2="34" y2="28" stroke="#a78bfa" stroke-width="2.8"/><circle cx="29" cy="22" r="2.5" fill="#a78bfa"/><circle cx="29" cy="34" r="2.5" fill="#a78bfa"/></svg></div>
      <div class="cbtn" style="border-color:var(--or);background:var(--c2)" onclick="openModal('objetos')"><svg width="34" height="34" viewBox="0 0 44 44"><circle cx="15" cy="17" r="9" fill="none" stroke="#f97316" stroke-width="2"/><path d="M10,9 Q15,17 10,25" fill="none" stroke="#f97316" stroke-width="1.4"/><path d="M20,9 Q15,17 20,25" fill="none" stroke="#f97316" stroke-width="1.4"/><line x1="6" y1="17" x2="24" y2="17" stroke="#f97316" stroke-width="1.4"/><polygon points="28,32 36,25 44,32" fill="none" stroke="#5dcaa5" stroke-width="2"/><rect x="30" y="32" width="12" height="10" rx="1" fill="none" stroke="#5dcaa5" stroke-width="1.8"/></svg></div>
      <div class="cbtn gbg" style="border-color:var(--g)" onclick="openModal('fraccion')"><svg width="34" height="34" viewBox="0 0 44 44"><text x="22" y="18" text-anchor="middle" font-size="13" fill="#5dcaa5" font-family="Georgia,serif" font-weight="700">a</text><line x1="10" y1="23" x2="34" y2="23" stroke="#5dcaa5" stroke-width="2.2"/><text x="22" y="37" text-anchor="middle" font-size="13" fill="#a78bfa" font-family="Georgia,serif" font-weight="700">b</text></svg></div>
      <div class="cbtn" style="border-color:var(--p)" onclick="openModal('dinero')"><svg width="34" height="34" viewBox="0 0 44 44"><text x="22" y="30" text-anchor="middle" font-size="26" fill="#5dcaa5" font-family="Georgia,serif" font-weight="700">$</text><line x1="22" y1="8" x2="22" y2="14" stroke="#5dcaa5" stroke-width="2"/><line x1="22" y1="30" x2="22" y2="36" stroke="#5dcaa5" stroke-width="2"/></svg></div>
      <div class="cbtn rdbg" style="border-color:var(--rd)" onclick="borrarUltimo()"><svg width="34" height="34" viewBox="0 0 44 44"><path d="M18,12 L36,12 Q40,12 40,16 L40,28 Q40,32 36,32 L18,32 L8,22 Z" fill="none" stroke="#e74c3c" stroke-width="2.2" stroke-linejoin="round"/><line x1="24" y1="18" x2="32" y2="26" stroke="#e74c3c" stroke-width="2.5"/><line x1="32" y1="18" x2="24" y2="26" stroke="#e74c3c" stroke-width="2.5"/></svg></div>
    </div>
    <div class="scroll-hint">↕ desliza para ver todos los botones</div>
  </div>
</div>

<!-- MODAL -->
<div class="overlay" id="overlay" onclick="overlayClick(event)">
  <div class="modal" id="modal">
    <div class="modal-header">
      <div class="modal-title" id="modal-title"></div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div id="modal-body"></div>
  </div>
</div>

<script>
const PI=Math.PI;
const r4=(n,d=4)=>isNaN(n)||!isFinite(n)?"—":parseFloat(n.toFixed(d));
let lines=[],inputActual="";

// ── DISPLAY ──────────────────────────────────────────────────
function rd(){
  const dl=document.getElementById("dl"),ib=document.getElementById("ib"),ie=document.getElementById("ie");
  if(!lines.length&&!inputActual){dl.innerHTML='<div style="font-size:12px;color:#2a3550">Toca un botón para insertar...</div>';ib.style.display="none";return;}
  dl.innerHTML=lines.map(l=>{
    if(l.t==="expr")return`<div class="line-expr">${l.v}</div>`;
    if(l.t==="res"){
      let h=`<div class="line-result-wrap"><span class="line-result-eq">= </span><span class="line-result-val" style="color:${l.ok?"var(--p)":"var(--rd)"}">${l.v}</span></div>`;
      if(l.ps&&l.ok)h+=`<div class="proc-box"><div class="proc-title">Procedimiento</div>${l.ps.map((p,i)=>`<div class="proc-step"><div class="step-num">${i+1}</div><div style="flex:1"><div class="step-label">${p.l}</div><div class="step-val">${p.v}</div></div></div>`).join("")}</div>`;
      return h;
    }
    return`<div class="line-term">${l.v}</div>`;
  }).join("");
  dl.scrollTop=dl.scrollHeight;
  if(inputActual){ib.style.display="block";ie.innerHTML=inputActual+'<span class="cursor"></span>';}
  else ib.style.display="none";
}

function addLine(txt){lines.push({t:"term",v:txt});rd();}
function appendInput(c){inputActual+=c;rd();}

function presionarIgual(){
  const expr=inputActual.trim();if(!expr)return;
  try{
    const clean=expr.replace(/×/g,"*").replace(/÷/g,"/").replace(/−/g,"-");
    const res=Function('"use strict";return('+clean+')')();
    const val=isFinite(res)?r4(res,8):null;
    lines.push({t:"expr",v:expr});
    lines.push({t:"res",v:val!==null?String(val):"Error",ok:val!==null,ps:genPasos(expr,val)});
  }catch{
    lines.push({t:"expr",v:expr});
    lines.push({t:"res",v:"Error — revisa la expresión",ok:false,ps:null});
  }
  inputActual="";rd();
}

function genPasos(expr,res){
  const c=expr.trim(),ps=[];
  if(c.includes("+")){const p=c.split("+").map(s=>s.trim());ps.push({l:"Operación: SUMA",v:p.join(" + ")});ps.push({l:"Resultado",v:`${p.join(" + ")} = ${res}`});}
  else if(c.replace(/[0-9.\s]/g,"").startsWith("-")||c.includes(" - ")){ps.push({l:"Operación: RESTA",v:c});ps.push({l:"Resultado",v:`${c} = ${res}`});}
  else if(c.includes("×")||c.includes("*")){const p=c.replace(/×/g,"*").split("*").map(s=>s.trim());ps.push({l:"Operación: MULTIPLICACIÓN",v:p.join(" × ")});ps.push({l:"Resultado",v:`${p[0]} × ${p[1]} = ${res}`});}
  else if(c.includes("÷")||c.includes("/")){const p=c.replace(/÷/g,"/").split("/").map(s=>s.trim());ps.push({l:"Operación: DIVISIÓN",v:`${p[0]} ÷ ${p[1]}`});ps.push({l:"Resultado",v:`${p[0]} ÷ ${p[1]} = ${res}`});}
  else{ps.push({l:"Expresión",v:`${c} = ${res}`});}
  return ps;
}

function borrarUltimo(){if(inputActual)inputActual=inputActual.slice(0,-1);else lines.pop();rd();}
function limpiarTodo(){lines=[];inputActual="";rd();}

// ── MODAL ────────────────────────────────────────────────────
function openModal(key){
  const cfg=modals[key];if(!cfg)return;
  document.getElementById("modal-title").textContent=cfg.title;
  document.getElementById("modal-body").innerHTML=cfg.html;
  if(cfg.init)setTimeout(cfg.init,60);
  document.getElementById("overlay").classList.add("show");
}
function closeModal(){document.getElementById("overlay").classList.remove("show");}
function overlayClick(e){if(e.target===document.getElementById("overlay"))closeModal();}

// ── HELPERS ──────────────────────────────────────────────────
function ibox(title,text,col="#a78bfa"){
  const bg=col==="#5dcaa5"?"#0b1f18":"#1e1530";
  return`<div class="info-box" style="background:${bg};border-color:${col}"><div class="info-title" style="color:${col}">${title}</div><div class="info-text">${text}</div></div>`;
}
function rbox(grid,steps){
  return`<div class="result-box"><div class="rgrid">${grid.map(it=>`<div class="rcard"><div class="rcard-label">${it.l}</div><div class="rcard-val">${it.v}</div></div>`).join("")}</div><div class="proc-title" style="font-size:11px;color:var(--p);font-weight:700;margin-bottom:8px;border-left:3px solid var(--p);padding-left:8px">Procedimiento</div>${steps.map((s,i)=>`<div class="proc-step"><div class="step-num">${i+1}</div><div style="flex:1"><div class="step-label">${s.l}</div><div class="step-val">${s.v}</div></div></div>`).join("")}</div>`;
}
function fld(id,label,ph,type="number"){return`<div class="field"><label>${label}</label><input type="${type}" id="${id}" placeholder="${ph}" step="any"></div>`;}
const gv=id=>parseFloat(document.getElementById(id)?.value)||0;
const gvs=id=>document.getElementById(id)?.value||"";

// ── CÁLCULOS ─────────────────────────────────────────────────
function calcTrig(){
  const a=gv("tang"),rad=a*PI/180,sen=r4(Math.sin(rad),6),cos=r4(Math.cos(rad),6),tan=r4(Math.tan(rad),6);
  document.getElementById("trig-r").innerHTML=rbox([{l:"Sen",v:sen},{l:"Cos",v:cos},{l:"Tan",v:tan},{l:"Csc",v:r4(1/Math.sin(rad),6)},{l:"Sec",v:r4(1/Math.cos(rad),6)},{l:"Cot",v:r4(1/Math.tan(rad),6)}],[{l:"Convertir a radianes",v:`${a}°×π/180=${r4(rad,6)} rad`},{l:"sen y cos",v:`sen=${sen}  cos=${cos}`},{l:"tan=sen/cos",v:tan},{l:"Verificación sen²+cos²",v:`${r4(sen**2+cos**2,4)}≈1 ✓`}]);
  addLine(`sen(${a}°)=${sen}  cos=${cos}  tan=${tan}`);
}
function calcPob(){
  const nums=gvs("pob-d").split(",").map(s=>parseFloat(s.trim())).filter(n=>!isNaN(n));if(nums.length<2)return;
  const N=nums.length,sum=nums.reduce((a,b)=>a+b,0),m=r4(sum/N),v=r4(nums.reduce((a,x)=>a+(x-m)**2,0)/N),s=r4(Math.sqrt(v)),sorted=[...nums].sort((a,b)=>a-b);
  document.getElementById("pob-r").innerHTML=rbox([{l:"Media μ",v:m},{l:"Varianza σ²",v:v},{l:"Desv. σ",v:s},{l:"N",v:N},{l:"Mín",v:sorted[0]},{l:"Máx",v:sorted[N-1]}],[{l:"Población=conjunto COMPLETO",v:`N=${N}`},{l:"μ=Σx/N",v:`${sum}/${N}=${m}`},{l:"σ²=Σ(x-μ)²/N",v:v},{l:"σ=√σ²",v:`√${v}=${s}`}]);
  addLine(`POB: μ=${m}, σ=${s}, N=${N}`);
}
function calcMuestra(){
  const nums=gvs("mue-d").split(",").map(s=>parseFloat(s.trim())).filter(n=>!isNaN(n));if(nums.length<2)return;
  const n=nums.length,sum=nums.reduce((a,b)=>a+b,0),m=r4(sum/n),v=r4(nums.reduce((a,x)=>a+(x-m)**2,0)/(n-1)),s=r4(Math.sqrt(v)),se=r4(s/Math.sqrt(n),4);
  document.getElementById("mue-r").innerHTML=rbox([{l:"Media x̄",v:m},{l:"Varianza s²",v:v},{l:"Desv. s",v:s},{l:"Error SE",v:se},{l:"n",v:n}],[{l:"Muestra usa n-1 (Bessel)",v:`n=${n}`},{l:"x̄=Σx/n",v:`${sum}/${n}=${m}`},{l:"s²=Σ(x-x̄)²/(n-1)",v:v},{l:"s=√s²",v:s},{l:"SE=s/√n",v:se}]);
  addLine(`Muestra: x̄=${m}, s=${s}, n=${n}`);
}
let dTipo="Población";
function setDTipo(t){dTipo=t;["Población","Muestra"].forEach(x=>{const b=document.getElementById("dt-"+x);if(b)b.className="sub-btn"+(x===t?" active":"");});}
function calcDesv(){
  const nums=gvs("desv-d").split(",").map(s=>parseFloat(s.trim())).filter(n=>!isNaN(n));if(nums.length<2)return;
  const n=nums.length,m=r4(nums.reduce((a,b)=>a+b,0)/n),div=dTipo==="Población"?n:n-1,diffs=nums.map(x=>r4((x-m)**2)),v=r4(diffs.reduce((a,b)=>a+b,0)/div),s=r4(Math.sqrt(v));
  document.getElementById("desv-r").innerHTML=rbox([{l:"D.E",v:s},{l:"Varianza",v:v},{l:"Media",v:m},{l:"N/n",v:n}],[{l:`Datos (${n})`,v:nums.join(", ")},{l:"Media",v:m},{l:"(xi-media)²",v:diffs.map((d,i)=>`(${nums[i]}-${m})²=${d}`).join("  ")},{l:`Varianza/${div}`,v:v},{l:"D.E=√varianza",v:`√${v}=${s}`}]);
  addLine(`D.E(${dTipo}): σ=${s}, var=${v}, media=${m}`);
}
function calcPct(){
  const val=gv("pct-v"),pct=gv("pct-p"),res=r4(val*pct/100);
  document.getElementById("pct-r").innerHTML=rbox([{l:"Resultado",v:res},{l:"%",v:pct+"%"},{l:"Complemento",v:r4(val-res)}],[{l:"Resultado=(Valor×%)/100",v:`(${val}×${pct})/100=${res}`},{l:"Complemento",v:`${val}-${res}=${r4(val-res)}`}]);
  addLine(`${pct}% de ${val}=${res}`);
}
function calcRaiz(){
  const n=gv("raiz-n"),r=r4(Math.sqrt(n),8);
  document.getElementById("raiz-r").innerHTML=rbox([{l:"√"+n,v:r},{l:"Verificación",v:r4(r*r,4)+"≈"+n}],[{l:"√n=valor que al cuadrado da n",v:`√${n}=${r}`},{l:"Verificación",v:`${r}²=${r4(r*r,6)}≈${n} ✓`}]);
  addLine(`√${n}=${r}`);
}
function calcSigma(){
  const nums=gvs("sig-d").split(",").map(s=>parseFloat(s.trim())).filter(n=>!isNaN(n));if(!nums.length)return;
  const sum=r4(nums.reduce((a,b)=>a+b,0));
  document.getElementById("sig-r").innerHTML=rbox([{l:"Σ",v:sum},{l:"N",v:nums.length},{l:"Promedio",v:r4(sum/nums.length)}],[{l:"Σ=suma de todos los términos",v:nums.join("+")+"="+sum},{l:"Promedio=Σ/N",v:`${sum}/${nums.length}=${r4(sum/nums.length)}`}]);
  addLine(`Σ(${nums.join(",")})=${sum}`);
}
function calcMMM(){
  const nums=gvs("mmm-d").split(",").map(s=>parseFloat(s.trim())).filter(n=>!isNaN(n));if(nums.length<2)return;
  const n=nums.length,sum=nums.reduce((a,b)=>a+b,0),m=r4(sum/n),sorted=[...nums].sort((a,b)=>a-b),mid=Math.floor(n/2);
  const med=n%2===0?r4((sorted[mid-1]+sorted[mid])/2):sorted[mid];
  const freq={};nums.forEach(x=>{freq[x]=(freq[x]||0)+1;});const maxF=Math.max(...Object.values(freq));
  const moda=Object.entries(freq).filter(([,f])=>f===maxF).length===n?"Sin moda":Object.entries(freq).filter(([,f])=>f===maxF).map(([v])=>v).join(", ");
  document.getElementById("mmm-r").innerHTML=rbox([{l:"Media x̄",v:m},{l:"Mediana",v:med},{l:"Moda",v:moda},{l:"N",v:n}],[{l:"Media=Σx/n",v:`${sum}/${n}=${m}`},{l:"Datos ordenados",v:sorted.join(", ")},{l:"Mediana (valor central)",v:med},{l:"Moda (más frecuente)",v:moda}]);
  addLine(`Media=${m}, Mediana=${med}, Moda=${moda}`);
}
function calcFrac(){
  const na=parseInt(gvs("fn1")),da=parseInt(gvs("fd1")),nb=parseInt(gvs("fn2")),db=parseInt(gvs("fd2"));
  const mcd=(a,b)=>b===0?a:mcd(b,a%b),sim=(n,d)=>{if(!d)return[n,1];const m=mcd(Math.abs(n),Math.abs(d));return[n/m,d/m];};
  const[sn,sd]=sim(na*db+nb*da,da*db),[rn,rd2]=sim(na*db-nb*da,da*db),[mn,md]=sim(na*nb,da*db),[dn,dd]=sim(na*db,da*nb);
  document.getElementById("frac-r").innerHTML=rbox([{l:"Suma",v:`${sn}/${sd}`},{l:"Resta",v:`${rn}/${rd2}`},{l:"Mult.",v:`${mn}/${md}`},{l:"Div.",v:`${dn}/${dd}`}],[{l:"Fracciones",v:`${na}/${da}  y  ${nb}/${db}`},{l:"Suma: denominador común",v:`${sn}/${sd}`},{l:"Resta",v:`${rn}/${rd2}`},{l:"Multiplicación",v:`${mn}/${md}`},{l:"División: invertir y mult.",v:`${dn}/${dd}`}]);
  addLine(`${na}/${da} ops ${nb}/${db} → Suma:${sn}/${sd} Mult:${mn}/${md}`);
}
const tasas={USD:1,EUR:0.92,GBP:0.79,JPY:149.5,COP:3900,MXN:17.1,BRL:4.97,CAD:1.36,ARS:870,CLP:920,PEN:3.72,CRC:520};
const monedas=[["USD","Dólar US"],["EUR","Euro"],["GBP","Libra"],["JPY","Yen"],["COP","Peso col."],["MXN","Peso mex."],["BRL","Real bras."],["CAD","Dólar can."],["ARS","Peso arg."],["CLP","Peso chi."],["PEN","Sol per."],["CRC","Colón CR"]];
function mopts(sel="USD"){return monedas.map(([v,l])=>`<option value="${v}"${v===sel?" selected":""}>${v} – ${l}</option>`).join("");}
function calcDin(){
  const m=gv("din-m"),desde=gvs("din-d"),hacia=gvs("din-h"),usd=m/tasas[desde],res=r4(usd*tasas[hacia]);
  document.getElementById("din-r").innerHTML=rbox([{l:`${m} ${desde}`,v:"→"},{l:"Resultado",v:`${res} ${hacia}`}],[{l:"Paso 1: → USD",v:`${m}${desde}÷${tasas[desde]}=${r4(usd,6)} USD`},{l:`Paso 2: USD→${hacia}`,v:`${r4(usd,6)}×${tasas[hacia]}=${res} ${hacia}`}]);
  addLine(`${m} ${desde} = ${res} ${hacia}`);
}

