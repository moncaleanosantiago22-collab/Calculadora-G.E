}

function calcFig(){
  if(!figSel)return;
  const res=figSel[figModo].fn();
  const ctx=figModo==="area"?{t:"Área",u:"m²",i:"📐"}:{t:"Perímetro",u:"m",i:"📏"};
  const enun=document.getElementById("fig-enun");
  enun.style.display="block";
  enun.innerHTML=`<b style="color:var(--g)">PROBLEMA:</b> Si un ${figSel.n.toLowerCase()} tiene las medidas ingresadas, ¿cuál es su ${ctx.t.toLowerCase()}?<br>¿Cuánto mide ${figModo==="area"?"el espacio de":"el contorno de"} ${figSel.ctx[figModo]}?`;
  document.getElementById("fig-res").innerHTML=rbox([{l:`${ctx.i} ${ctx.t}`,v:`${res.v} ${ctx.u}`},{l:"Fórmula",v:res.f}],res.s)+
    `<button class="insert-btn" onclick="addLine('${figSel.ico} ${figSel.n} — ${ctx.t}: ${res.v} ${ctx.u} (${res.f})');closeModal()">✓ Insertar en pantalla y cerrar</button>`;
}

